# Supabase project used for application authentication.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only credentials. SUPABASE_SECRET_KEY is preferred.
# Never prefix these with NEXT_PUBLIC_ or commit real values.
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt

# Optional private Storage bucket used by deployed serverless functions.
SUPABASE_DIRECTORY_BUCKET=mingle-directory-data
# Optional local diagnostic override. Vercel uses remote data automatically.
DIRECTORY_DATA_SOURCE=remote

# Optional live Slack profile enrichment for deployed server routes.
# These browser-session credentials expire and must remain server-only.
SLACK_ORIGIN=https://your-workspace.slack.com
SLACK_TOKEN=xoxc-your-session-token
SLACK_COOKIE=your-complete-slack-cookie-header

# Used only by `npm run auth:bootstrap` to create or promote the first admin.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=super-admin
ADMIN_PASSWORD=replace-with-a-strong-password
